{
  "created_at": "2026-10-24T15:37:56.038124+00:00",
  "created_by": "ARGUS demo authors",
  "demo": {
    "description": "A medium-sized IT organisation: a service catalogue (network, internet, Wi-Fi, mail, DNS, hosting, storage, backup, monitoring, service desk, VPN, HPC, LLM inference), three buildings with floors, rooms and racks, a GPU cluster for HPC and LLM inference, user workstations, a port-to-port network map, mapped and placed equipment, dependencies, incidents, requests and changes, maintenance activities, runbooks, contracts and SLAs.",
    "notice": "Synthetic demo: Northfield IT Services, its people, suppliers, addresses and figures are fictional. Nothing here describes a real organisation or real equipment.",
    "organisation": "Northfield IT Services (fictional)",
    "steps": [
      {
        "link": "/map",
        "text": "The campus: Hub Building, Library and Annex outlined, with the fibre routes between them. Pick the Hub Building's ground floor to see its plan.",
        "title": "Start on the map"
      },
      {
        "link": "/assets/nf-bld-hub",
        "text": "Its floors, rooms and floor plans: the Data Hall, the Network Room (MDF), the Power Room.",
        "title": "Open the Hub Building"
      },
      {
        "link": "/assets/nf-rack-mdf1",
        "text": "Rack R-MDF1 in the Network Room holds the core switches, firewalls and WAN routers, each at its rack unit.",
        "title": "Look inside a rack"
      },
      {
        "link": "/assets/nf-sw-core-01",
        "text": "Core switch 01: where it stands, what it connects to, its contract, its change ticket.",
        "title": "Follow a piece of equipment"
      },
      {
        "link": "/documents/nf-doc-port-map",
        "text": "Every link is a cable between two ports, and each access port is on its VLAN. The port map lists them; a ticket even points at a single switch port.",
        "title": "Follow a cable, port to port"
      },
      {
        "link": "/assets/nf-svc-mail",
        "text": "Email depends on Virtual Hosting, DNS and the Campus Network, and is provided by the mail server on hypervisor host 01.",
        "title": "See what a service depends on"
      },
      {
        "link": "/assets/nf-svc-llm",
        "text": "LLM Inference runs on GPU-03 and GPU-04 behind a gateway; HPC Batch on GPU-01, GPU-02, a login node and scratch storage, over a 200 Gb/s fabric.",
        "title": "HPC and LLM services"
      },
      {
        "link": "/tickets/nf-t-001",
        "text": "Library Wi-Fi drops: traced to access point LIB-02, linked to a problem record and to the completed replacement.",
        "title": "An incident and its cause"
      },
      {
        "link": "/activities",
        "text": "Weekly restore tests, the monthly UPS self-test and the core switch upgrade window.",
        "title": "Planned work"
      },
      {
        "link": "/documents/nf-doc-arch",
        "text": "The campus network architecture, with its diagram and links to every device it describes.",
        "title": "Read the documentation"
      }
    ],
    "synthetic": true,
    "title": "IT Services"
  },
