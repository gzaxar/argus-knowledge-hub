# Public configuration for direct login to INFN's TEST Keycloak.
# Public client: Authorization Code with PKCE; no client secret or API token mediation.
OIDC_ISSUER=https://idp-test.app.infn.it/auth/realms/aai
OIDC_JWKS_URI=https://idp-test.app.infn.it/auth/realms/aai/protocol/openid-connect/certs
OIDC_AUDIENCE=argus-knowledge-hub
# Trusted beside INFN AAI: Google (the web's Google button) and the local Keycloak (the mobile app, test users).
OIDC_EXTRA_PROVIDERS=[{"issuer": "https://securetoken.google.com/seraphic-camera-479521-s5", "jwks_uri": "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com", "audience": "seraphic-camera-479521-s5"}, {"issuer": "http://localhost:8081/realms/argus-dev", "jwks_uri": "http://keycloak:8080/realms/argus-dev/protocol/openid-connect/certs", "audience": "argus-webapp"}]
VITE_OIDC_AUTHORITY=https://idp-test.app.infn.it/auth/realms/aai
VITE_OIDC_CLIENT_ID=argus-knowledge-hub
VITE_OIDC_LABEL=INFN login
