# Public configuration for direct login to INFN's TEST Keycloak.
# Public client: Authorization Code with PKCE; no client secret or API token mediation.
OIDC_ISSUER=https://idp-test.app.infn.it/auth/realms/aai
OIDC_JWKS_URI=https://idp-test.app.infn.it/auth/realms/aai/protocol/openid-connect/certs
OIDC_AUDIENCE=argus-knowledge-hub
VITE_OIDC_AUTHORITY=https://idp-test.app.infn.it/auth/realms/aai
VITE_OIDC_CLIENT_ID=argus-knowledge-hub
VITE_OIDC_LABEL=INFN login
